{
  "name": "shipcheck",
  "version": "0.1.0",
  "description": "Independent review layer for AI-assisted software development (pre-alpha).",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "shipcheck": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs",
    "scripts/cli-acceptance.mjs",
    "scripts/qualify-processes.mjs",
    "scripts/qualify-release.mjs",
    "examples/capture-audit.mjs",
    "fixtures/demo",
    "fixtures/contracts",
    "fixtures/contracts-expanded",
    "fixtures/architecture",
    "fixtures/integrations",
    "fixtures/developer-loop",
    "tasks/example.json",
    "tasks/backlog.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "shipcheck": "tsx src/cli.ts",
    "audit": "tsx src/cli.ts audit",
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:cli": "npm run build --silent && node scripts/cli-acceptance.mjs",
    "qualify:processes": "npm run build --silent && node scripts/qualify-processes.mjs",
    "qualify:tools": "npm run build --silent && node scripts/qualify-release.mjs",
    "verify": "npm run typecheck && npm test && npm run test:cli",
    "test:watch": "vitest",
    "evaluate": "npm run build --silent && node scripts/evaluate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/napi": "0.45.3",
    "@babel/parser": "7.29.9",
    "@lezer/common": "1.5.3",
    "@lezer/python": "1.1.19",
    "acorn": "8.18.0",
    "semver": "7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/semver": "7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
